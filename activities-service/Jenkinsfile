pipeline {
    agent any
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build') {
            steps {
                dir('activities-service') {
                    sh 'echo "Compilation Maven..."'
                    sh 'docker run --rm -v $PWD:/app -w /app maven:3.9.9-eclipse-temurin-17 mvn clean package -DskipTests'
                }
            }
        }
        
        stage('Docker Build') {
            steps {
                dir('activities-service') {
                    sh 'echo "Construction image Docker..."'
                    sh 'docker build -t cognivita/activities-service:latest .'
                }
            }
        }
        
        stage('Deploy') {
            steps {
                dir('activities-service') {
                    sh 'echo "Déploiement..."'
                    sh 'docker-compose up -d'
                }
            }
        }
        
        stage('Test API') {
            steps {
                sh '''
                    sleep 10
                    curl -s http://localhost:8088/api/activities && echo " API OK" || echo " API KO"
                '''
            }
        }
    }
    
    post {
        success {
            echo '🎉 Pipeline réussi !'
        }
        failure {
            echo '❌ Pipeline échoué !'
        }
    }
}
