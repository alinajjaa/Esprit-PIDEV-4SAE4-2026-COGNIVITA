pipeline {
    agent any
    
    stages {
        stage('Build') {
            steps {
                echo 'Building activities-service...'
                dir('activities-service') {
                    sh 'docker run --rm -v $PWD:/app -w /app maven:3.9.9-eclipse-temurin-17 mvn clean package -DskipTests'
                    sh 'docker build -t activities-service:latest .'
                }
            }
        }
        
        stage('Deploy') {
            steps {
                dir('activities-service') {
                    sh 'docker-compose up -d'
                }
            }
        }
        
        stage('Test') {
            steps {
                sh 'curl http://localhost:8088/api/activities'
            }
        }
    }
}
