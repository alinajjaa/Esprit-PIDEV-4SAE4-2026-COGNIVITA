pipeline {
  agent none

  options {
    timestamps()
    ansiColor('xterm')
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  environment {
    // Image Docker à produire
    IMAGE_NAME = "cognivita/activities-service"
    IMAGE_TAG  = "${env.BUILD_NUMBER}"

    // Registry Docker (par défaut Docker Hub). Exemple Harbor: registry.mycorp.local
    DOCKER_REGISTRY = ""
  }

  stages {
    stage('Checkout') {
      agent any
      steps {
        checkout scm
      }
    }

    stage('Build & Unit Tests (Maven)') {
      agent {
        docker {
          image 'maven:3.9.9-eclipse-temurin-17'
          args '-u root:root'
          reuseNode true
        }
      }
      steps {
        sh 'mvn -B -DskipTests=false test'
        sh 'mvn -B -DskipTests package'
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
        }
      }
    }

    stage('SonarQube Analysis') {
      agent {
        docker {
          image 'maven:3.9.9-eclipse-temurin-17'
          args '-u root:root'
          reuseNode true
        }
      }
      steps {
        // IMPORTANT:
        // - Configurer Jenkins: "SonarQube servers" (Manage Jenkins -> System)
        // - Créer un credential secret text "SONAR_TOKEN"
        withSonarQubeEnv('sonarqube') {
          withCredentials([string(credentialsId: 'SONAR_TOKEN', variable: 'SONAR_TOKEN')]) {
            sh '''
              mvn -B -DskipTests sonar:sonar \
                -Dsonar.login=$SONAR_TOKEN
            '''
          }
        }
      }
    }

    stage('Quality Gate') {
      agent any
      steps {
        // Attente du quality gate (nécessite l'intégration Jenkins-SonarQube)
        timeout(time: 10, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true
        }
      }
    }

    stage('Build Docker Image') {
      agent {
        docker {
          // Image avec docker CLI (utilise Docker-in-Docker via DOCKER_HOST)
          image 'docker:27-cli'
          args '--entrypoint=""'
          reuseNode true
        }
      }
      environment {
        // IMPORTANT: en infra Jenkins locale (docker-compose.jenkins.yml),
        // DOCKER_HOST est fourni pour parler au service "docker" (dind).
        DOCKER_BUILDKIT = "1"
      }
      steps {
        sh '''
          docker version
          docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
          docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest
        '''
      }
    }

    stage('Push Docker Image') {
      when {
        expression { return env.DOCKERHUB_USER != null }
      }
      agent {
        docker {
          image 'docker:27-cli'
          args '--entrypoint=""'
          reuseNode true
        }
      }
      steps {
        // IMPORTANT:
        // - Créer un credential Jenkins "DOCKERHUB" (username/password)
        withCredentials([usernamePassword(credentialsId: 'DOCKERHUB', usernameVariable: 'DOCKERHUB_USER', passwordVariable: 'DOCKERHUB_PASS')]) {
          sh '''
            echo "$DOCKERHUB_PASS" | docker login -u "$DOCKERHUB_USER" --password-stdin
            docker push ${IMAGE_NAME}:${IMAGE_TAG}
            docker push ${IMAGE_NAME}:latest
          '''
        }
      }
    }

    stage('Deploy to Test (docker-compose)') {
      agent {
        docker {
          image 'docker:27-cli'
          args '--entrypoint=""'
          reuseNode true
        }
      }
      steps {
        // Exemple de déploiement test local/VM (adapter selon ton infra)
        sh '''
          docker compose up -d --build
          docker compose ps
        '''
      }
    }

    stage('Integration Tests') {
      agent any
      steps {
        // Ici on exécute un test simple HTTP (tu peux remplacer par Postman/Newman, RestAssured, etc.)
        // On teste les endpoints exposés localement par compose.
        powershell '''
          ./test.ps1
        '''
      }
    }

    stage('Deploy to Production') {
      agent any
      steps {
        // Déploiement prod: manuel (input) ou auto (quand stable)
        input message: 'Déployer en production ?', ok: 'Déployer'
        echo "Déploiement production: à implémenter (K8s/VM/Harbor, etc.)"
      }
    }
  }

  post {
    success {
      echo "Pipeline OK: ${IMAGE_NAME}:${IMAGE_TAG}"
      // Notification optionnelle (Slack/Email)
      // slackSend channel: '#ci', message: "Build OK: ${env.JOB_NAME} #${env.BUILD_NUMBER}"
      // mail to: 'team@exemple.com', subject: "Build OK ${env.JOB_NAME} #${env.BUILD_NUMBER}", body: "OK"
    }
    failure {
      echo "Pipeline KO"
      // slackSend channel: '#ci', message: "Build KO: ${env.JOB_NAME} #${env.BUILD_NUMBER}"
    }
  }
}

