pipeline {
    agent any

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        IMAGE_NAME = "cognivita/activities-service"
        IMAGE_TAG  = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/alinajjaa/Esprit-PIDEV-4SAE4-2026-COGNIVITA.git'
            }
        }

        stage('Build & Package') {
            steps {
                dir('activities-service') {
                    sh 'docker run --rm -v $PWD:/app -w /app maven:3.9.9-eclipse-temurin-17 mvn clean package -DskipTests'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('activities-service') {
                    sh '''
                        docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                        docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('activities-service') {
                    sh 'docker compose up -d'
                }
            }
        }

        stage('Test') {
            steps {
                sh '''
                    sleep 10
                    curl -s http://localhost:8087/api/activities > /dev/null && echo "API OK" || echo "API KO"
                    curl -s http://localhost:8087/api/journal > /dev/null && echo "Journal OK" || echo "Journal KO"
                '''
            }
        }
    }

    post {
        success {
            echo "🎉 Pipeline réussi ! Image: ${IMAGE_NAME}:${IMAGE_TAG}"
        }
        failure {
            echo "❌ Pipeline échoué !"
        }
    }
}
