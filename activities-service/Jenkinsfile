pipeline {
    agent any
    
    environment {
        IMAGE_NAME = "cognivita/activities-service"
        IMAGE_TAG = "${env.BUILD_NUMBER}"
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Compilation Maven') {
            steps {
                dir('activities-service') {
                    sh 'docker run --rm -v $PWD:/app -w /app maven:3.9.9-eclipse-temurin-17 mvn clean package -DskipTests'
                }
            }
        }
        
        stage('Build Docker Image') {
            steps {
                dir('activities-service') {
                    sh 'docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .'
                    sh 'docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest'
                }
            }
        }
        
        stage('Déploiement') {
            steps {
                dir('activities-service') {
                    sh 'docker-compose up -d'
                }
            }
        }
        
        stage('Test API') {
            steps {
                sh '''
                    sleep 15
                    curl -s http://localhost:8088/api/activities && echo " API OK" || echo " API KO"
                '''
            }
        }
    }
    
    post {
        success {
            echo "✅ Pipeline réussi !"
        }
        failure {
            echo "❌ Pipeline échoué"
        }
    }
}
