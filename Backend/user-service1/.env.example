# =============================================================================
# COGNIVITA — user-service1 environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/alzheimerdb1?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=
DB_PASSWORD=

# ── JPA ───────────────────────────────────────────────────────────────────────
# Use "update" for dev, "validate" or "none" for production
JPA_DDL=update

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION=86400000

# ── Mail (Gmail SMTP) ─────────────────────────────────────────────────────────
# App password: myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
# Credentials: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8081/login/oauth2/code/google

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Credentials: cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Service URLs ──────────────────────────────────────────────────────────────
FACE_AUTH_URL=http://127.0.0.1:5001
EUREKA_URL=http://localhost:8761/eureka
CONFIG_SERVER_URL=http://localhost:8888

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:4200
