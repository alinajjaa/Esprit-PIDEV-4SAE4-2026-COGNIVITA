# =============================================================================
# COGNIVITA — root environment variables (docker-compose)
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# =============================================================================

# ── MySQL ─────────────────────────────────────────────────────────────────────
# Strong password required — used by docker-compose MySQL container
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=cognivita
MYSQL_USER=cognivita_user
MYSQL_USER_PASSWORD=
