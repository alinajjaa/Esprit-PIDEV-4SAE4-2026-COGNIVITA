{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e:real": "cypress run --spec 'cypress/e2e/**/*.cy.ts'",
    "e2e:real:open": "cypress open",
    "e2e:auth": "cypress run --spec 'cypress/e2e/auth/*.cy.ts'",
    "e2e:users": "cypress run --spec 'cypress/e2e/users/*.cy.ts'",
    "e2e:nav": "cypress run --spec 'cypress/e2e/navigation/*.cy.ts'",
    "e2e:admin": "cypress run --spec 'cypress/e2e/admin/*.cy.ts'"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/service-worker": "^21.1.1",
    "face-api.js": "^0.22.2",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "ngx-webcam": "^0.4.1",
    "rxjs": "~7.8.0",
    "three": "^0.182.0",
    "three-stdlib": "^2.36.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.1",
    "@angular/cli": "^21.1.1",
    "@angular/compiler-cli": "^21.1.0",
    "@types/three": "^0.182.0",
    "cypress": "^15.13.1",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
